{
  "name": "tripplanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "data:airports": "tsx scripts/build-airports.ts",
    "fixtures:record": "NODE_OPTIONS=--conditions=react-server tsx scripts/record-fixtures.ts",
    "smoke:flights": "NODE_OPTIONS=--conditions=react-server tsx scripts/smoke-flights.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/luxon": "3.7.6",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
